# Copia este archivo como .env junto a docker-compose.yml y ajusta los valores.
# Docker Compose lo carga automaticamente para sustituir las variables ${...}.
#
DB_URL=jdbc:postgresql://db:5432/servas
DB_USER=servas
DB_PASSWORD=servas
REDIS_HOST=redis
REDIS_PORT=6379

# Habilita la carga de datos de ejemplo al arrancar (Flyway + seeder).
# En produccion usar false.
SEED_ENABLED=true

SERVER_PORT=8080

# Origenes permitidos para CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Retencion de metricas (VictoriaMetrics) y logs (VictoriaLogs).
VM_RETENTION=2w
VL_RETENTION=2w

# Credenciales de administrador de Grafana (dashboard de observabilidad).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SonarQube (usuario/BD del servidor de calidad). Solo local; en CI usa variables de secretos.
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_PORT=9000