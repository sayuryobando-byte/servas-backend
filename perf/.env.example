# Variables de k6 (se pasan con -e al contenedor; ver run.ps1 / run.sh)

# URL base de la API. Desde el contenedor de k6 usa host.docker.internal
# para llegar al host. Si pruebas contra otro entorno, cambialo aqui.
BASE_URL=http://host.docker.internal:8080

# Password de los proveedores demo del seeder.
PASSWORD=Demo1234!

# Total de proveedores sembrados (los N%5!=0 estan verificados).
PROVIDER_COUNT=50

# Ajuste de carga por escenario (si se omiten, usan los defaults del script).
BROWSER_VUS=15
BOOKING_VUS=5
BACKOFFICE_VUS=3
CONCURRENT_VUS=50
SPIKE_VUS=150
STRESS_MAX_VUS=120
BREAKPOINT_MAX_VUS=250
SOAK_DURATION=30m
WARMUP_DURATION=1m
HOLD_DURATION=5m
RAMPDOWN_DURATION=1m

# Pausa (think time) simulada entre acciones y timeout HTTP.
THINK_TIME_MS=800
HTTP_TIMEOUT=30s